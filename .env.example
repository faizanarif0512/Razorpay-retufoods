# ==============================================================================
# RETÜ FOODS STORE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: NEVER commit real credentials or secret keys to version control.
# ==============================================================================

# --- STORE APPLICATION & HOSTING ---
# Public URL of the storefront. Used for invoice links, webhooks, and absolute redirects.
# Scope: Public / Server-side
NEXT_PUBLIC_STORE_URL="http://localhost:3000"

# --- RAZORPAY PAYMENT GATEWAY (TEST / LIVE) ---
# Razorpay Key ID - Available in Razorpay Dashboard > Settings > API Keys
# Scope: Public (Client-side checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# Razorpay Key Secret - Available in Razorpay Dashboard > Settings > API Keys
# Scope: STRICTLY SERVER-SIDE. Never prefix with NEXT_PUBLIC_!
RAZORPAY_KEY_SECRET="placeholder_razorpay_key_secret"

# Razorpay Webhook Secret - Configured in Razorpay Dashboard > Settings > Webhooks
# Scope: STRICTLY SERVER-SIDE. Used to verify raw webhook HMAC signatures.
RAZORPAY_WEBHOOK_SECRET="placeholder_razorpay_webhook_secret"

# --- PERSISTENT DATABASE CONFIGURATION ---
# Database Storage Provider: 'sqlite' (default local embedded) or 'supabase' / 'postgres'
# Scope: Server-side
DATABASE_TYPE="sqlite"
# SQLite database file path (relative to project root or absolute)
SQLITE_DB_PATH="./data/retufoods.db"

# Optional Supabase / PostgreSQL Connection (When using Supabase):
# Scope: Server-side
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- ADMIN DASHBOARD AUTHENTICATION & SECURITY ---
# Secret passphrase / JWT signing secret for Admin and Customer sessions
# Scope: STRICTLY SERVER-SIDE
ADMIN_SESSION_SECRET="your_secure_admin_session_secret_min_32_characters_long"
CUSTOMER_SESSION_SECRET="your_secure_customer_session_secret_min_32_characters_long"
# Default initial admin email and password (for local setup; change upon first login)
ADMIN_INITIAL_EMAIL="admin@retufoods.com"
ADMIN_INITIAL_PASSWORD="your_secure_initial_admin_password_here"

# --- TRANSACTIONAL EMAIL PROVIDER ---
# Provider options: 'console' (for local logging without credentials), 'resend', or 'smtp'
EMAIL_PROVIDER="console"
# Transactional Email API Key (e.g., Resend re_... or SendGrid SG...)
EMAIL_API_KEY="placeholder_email_api_key"
# Verified sender email address matching your authenticated domain
EMAIL_FROM_ADDRESS="orders@retufoods.com"
EMAIL_ADMIN_NOTIFY="restoreme@retufoods.com"

# Optional SMTP Settings (if using SMTP provider instead of API):
SMTP_HOST="smtp.mailprovider.com"
SMTP_PORT="587"
SMTP_USER="orders@retufoods.com"
SMTP_PASS="placeholder_smtp_password"
SMTP_SECURE="false"

# --- BUSINESS & INVOICE CONFIGURATION ---
# Legal company details appearing on tax invoices and receipts
INVOICE_COMPANY_NAME="DancingEarth Food Private Limited"
INVOICE_BRAND_NAME="Retü Foods (mi-biotics™)"
INVOICE_ADDRESS_LINE1="2nd Floor, 235 Binnamangala, 13th Cross Road"
INVOICE_ADDRESS_LINE2="Indiranagar, Bengaluru, Karnataka 560038, India"
INVOICE_SUPPORT_PHONE="011-69269668"
INVOICE_SUPPORT_EMAIL="restoreme@retufoods.com"
INVOICE_GSTIN="" # Enter merchant GSTIN once verified
INVOICE_SERIES_PREFIX="RETU-INV-"
